# ---------------------------------------------------------------------------
# Bet Placer configuration. Copy to ".env" and fill in what you need.
# All values are optional — the app degrades gracefully when keys are missing.
# Variable names map to fields in src/bet_placer/config.py (case-insensitive).
# ---------------------------------------------------------------------------

# --- External data providers -------------------------------------------------
# API-Football (https://www.api-football.com/)
API_FOOTBALL_KEY=

# The Odds API (https://the-odds-api.com/) — enables live odds across sports.
ODDS_API_KEY=

# OpenWeatherMap for match-day weather.
OPENWEATHER_API_KEY=

# NewsAPI for narrative/sentiment context.
NEWS_API_KEY=

# --- Stake.com integration ---------------------------------------------------
# Optional Stake API token (Settings -> Security -> API Tokens).
STAKE_API_TOKEN=

# Override the GraphQL endpoint if needed.
STAKE_GRAPHQL_ENDPOINT=https://stake.com/_api/graphql

# Fetch Stake via a real Playwright Chromium browser to pass Cloudflare.
# Set to false to disable the browser entirely (falls back to DraftKings odds).
STAKE_USE_BROWSER=true

# Run Chromium headless (no visible window). Set STAKE_BROWSER_HEADLESS=0 to
# show a window — useful for the one-time Cloudflare / login check.
STAKE_BROWSER_HEADLESS=true

# Pre-launch Chromium when the API starts. Default off — the browser opens only
# when you request Stake odds or the bet builder (avoids popup spam on startup).
STAKE_BROWSER_WARMUP_ON_STARTUP=false

# Optional JSON file path for the private local portfolio/privacy store.
# Leave blank to use ~/.bet_placer/portfolio_state.json
PORTFOLIO_STORE_PATH=

# --- Consensus weighting (how much crowd signal influences the model) --------
CONSENSUS_WEIGHT_BETTORS=0.12
CONSENSUS_WEIGHT_WEB=0.08

# --- Ensemble model weights (normally tuned by the learning loop) ------------
ENSEMBLE_WEIGHT_POISSON=0.20
ENSEMBLE_WEIGHT_ELO=0.15
ENSEMBLE_WEIGHT_XGBOOST=0.25
ENSEMBLE_WEIGHT_LIGHTGBM=0.20
ENSEMBLE_WEIGHT_NEURAL=0.10
ENSEMBLE_WEIGHT_MONTE_CARLO=0.10

# Max probability nudge the intuition layer may apply (+/-).
INTUITION_MAX_ADJUSTMENT=0.08

# --- Bankroll / staking risk controls ---------------------------------------
# Fractional Kelly used for stake sizing.
KELLY_FRACTION=0.25

# Minimum expected value before a bet is surfaced.
MIN_EV_THRESHOLD=0.02

# Minimum confidence required to rank a bet.
MIN_CONFIDENCE=0.55

# Hard cap on a single stake as a percent of bankroll.
MAX_STAKE_PCT=3.0

# Max percent of a match's allocation that can go on one single.
MATCH_MAX_STAKE_PCT=50.0

# Default bankroll (INR) used for stake recommendations.
DEFAULT_BANKROLL=2000.0
