# Copy to ".env". All keys optional — app degrades without them.

# Live multi-league odds (EPL, UCL, NBA, …) — https://the-odds-api.com/
ODDS_API_KEY=

# Stake.com (Playwright browser for Cloudflare + placeable prices)
STAKE_API_TOKEN=
STAKE_GRAPHQL_ENDPOINT=https://stake.com/_api/graphql
STAKE_USE_BROWSER=false   # cloud default; set true locally for Stake browser
STAKE_BROWSER_HEADLESS=true
STAKE_BROWSER_WARMUP_ON_STARTUP=false

PORTFOLIO_STORE_PATH=

# Local API: skip background craft (use GitHub Actions worker instead)
CRAFT_DISABLE=false

# Ensemble (Poisson + Elo + heuristic GBM)
ENSEMBLE_WEIGHT_POISSON=0.45
ENSEMBLE_WEIGHT_ELO=0.35
ENSEMBLE_WEIGHT_GBM=0.20

INTUITION_MAX_ADJUSTMENT=0.08
CONSENSUS_WEIGHT_BETTORS=0.12
CONSENSUS_WEIGHT_WEB=0.08

KELLY_FRACTION=0.25
MIN_EV_THRESHOLD=0.02
MIN_CONFIDENCE=0.55
MAX_STAKE_PCT=3.0
MATCH_MAX_STAKE_PCT=50.0
DEFAULT_BANKROLL=2000.0
